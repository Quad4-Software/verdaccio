{
  "name": "@verdaccio/ui-components",
  "version": "5.0.0-next-9.21",
  "description": "Verdaccio UI Components",
  "author": "Juan Picado <juanpicado19@gmail.com>",
  "license": "MIT",
  "homepage": "https://verdaccio.org",
  "repository": {
    "type": "https",
    "url": "https://github.com/verdaccio/verdaccio",
    "directory": "packages/ui-components"
  },
  "bugs": {
    "url": "https://github.com/verdaccio/verdaccio/issues"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/verdaccio"
  },
  "main": "./build/index.js",
  "module": "./build/index.mjs",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.ts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    },
    "./build/*": "./build/*"
  },
  "scripts": {
    "test": "cross-env TZ=UTC vitest run",
    "clean": "rimraf ./build",
    "type-check": "tsc --noEmit -p tsconfig.build.json",
    "watch": "vite build --watch",
    "build": "vite build",
    "start": "cross-env BROWSER=none storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:github-markdown-css": "node tools/generate-github-markdown.mjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "5.9.1",
    "@microlink/react-json-view": "1.31.33",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/system": "9.4.0",
    "@verdaccio/ui-i18n": "workspace:10.0.0-next-9.5",
    "country-flag-icons": "1.6.20",
    "dayjs": "1.11.23",
    "debug": "4.4.3",
    "dompurify": "3.4.15",
    "highlight.js": "11.12.0",
    "i18next": "26.4.2",
    "js-base64": "3.9.3",
    "localstorage-memory": "1.0.3",
    "lodash-es": "4.18.1",
    "marked": "18.0.13",
    "marked-highlight": "2.2.4",
    "normalize.css": "8.0.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-i18next": "17.0.14",
    "react-markdown": "10.1.0",
    "react-router": "8.3.1",
    "react-virtualized": "9.22.6",
    "semver": "7.8.5",
    "swr": "2.5.1",
    "validator": "13.15.35",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-links": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.13.4",
    "@types/qrcode": "1.5.6",
    "@verdaccio/types": "workspace:14.0.0-next-9.14",
    "@vitejs/plugin-react": "6.1.1",
    "cross-env": "10.1.0",
    "generate-github-markdown-css": "6.6.0",
    "jsdom": "30.0.1",
    "mockdate": "3.0.5",
    "msw": "2.12.10",
    "msw-storybook-addon": "3.0.0",
    "mutationobserver-shim": "0.3.7",
    "rimraf": "6.1.3",
    "storybook": "10.6.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "whatwg-fetch": "3.6.20"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
