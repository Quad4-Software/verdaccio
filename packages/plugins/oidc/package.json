{
  "name": "verdaccio-oidc",
  "version": "14.0.0-next-9.31",
  "description": "OpenID Connect authentication and login plugin for Verdaccio",
  "keywords": [
    "oidc",
    "openid-connect",
    "oauth2",
    "sso",
    "private",
    "package",
    "repository",
    "registry",
    "verdaccio"
  ],
  "author": "Juan Picado <juanpicado19@gmail.com>",
  "license": "MIT",
  "homepage": "https://verdaccio.org",
  "repository": {
    "type": "https",
    "url": "https://github.com/verdaccio/verdaccio",
    "directory": "packages/plugins/oidc"
  },
  "bugs": {
    "url": "https://github.com/verdaccio/verdaccio/issues"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@verdaccio/auth": "workspace:9.0.0-next-9.31",
    "@verdaccio/config": "workspace:9.0.0-next-9.31",
    "@verdaccio/core": "workspace:9.0.0-next-9.31",
    "@verdaccio/middleware": "workspace:9.0.0-next-9.31",
    "@verdaccio/url": "workspace:14.0.0-next-9.31",
    "debug": "4.4.3",
    "express": "5.2.1",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/debug": "4.1.13",
    "@verdaccio/plugin-verifier": "workspace:1.0.0-next-9.27",
    "@verdaccio/types": "workspace:14.0.0-next-9.14",
    "express": "5.2.1",
    "nock": "13.5.6",
    "rimraf": "6.1.3",
    "supertest": "7.1.4",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "scripts": {
    "clean": "rimraf ./build",
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/verdaccio"
  },
  "module": "./build/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.ts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    },
    "./build/*": "./build/*"
  }
}
